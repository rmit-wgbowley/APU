[version]
format: 0.1.2

# -----------------------------------------------------------------------------------

[note]
application: "Characterizes the primary and secondary windings of the transformer"
description: "Generate flux linkage vs current of the primary and secondary windings"

# -----------------------------------------------------------------------------------

[core]



[primary]
name: "Primary"
steps: 25

turns: 42
current: [0, 500] m(A)

# ----------------------

[secondary]
name: "Secondary"
steps: 25

turns: 2
current: [0, 25] (A)

# ----------------------